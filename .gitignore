# SpecWeave
.specweave/cache/
.specweave/increments/*/logs/       # Gitignored, but structure preserved
.specweave/increments/*/test-results/
.specweave/state/
BabyInCarApp/.specweave/state/
.specweave/jobs/                    # Background job checkpoints and state
.specweave/docs-site-internal/      # Generated Docusaurus site for internal docs
.claude-plugin/                     # Plugin marketplace (framework files)
plugins/                            # Plugin implementations (framework files)

# Temporary scripts (one-off automation in root/app folders)
/*.py
/*.rb
/BabyInCarApp/*.py
/BabyInCarApp/*.rb
/BabyInCarApp/fastlane/*.rb
!/BabyInCarApp/fastlane/Appfile
!/BabyInCarApp/fastlane/Fastfile
!/BabyInCarApp/fastlane/Matchfile
!/BabyInCarApp/fastlane/Pluginfile

# Fastlane generated files
BabyInCarApp/fastlane/report.xml
BabyInCarApp/fastlane/test_output/
BabyInCarApp/fastlane/Preview.html
BabyInCarApp/fastlane/screenshots/
BabyInCarApp/fastlane/README.md

# Dependencies (framework-agnostic)
node_modules/          # JavaScript/TypeScript
.pnpm-store/
.yarn/
.npm/
__pycache__/           # Python
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
target/                # Rust
Cargo.lock
vendor/                # Go
go.sum

# Build outputs (framework-agnostic)
.next/                 # NextJS
dist/                  # Generic
build/                 # Generic
out/                   # Generic
.output/               # Nuxt
*.egg-info/            # Python
__pypackages__/        # Python
*.class                # Java
*.jar                  # Java
bin/                   # Go, Java

# Environment
.env
.env.local
.env.*.local
*.env

# Database (framework-agnostic)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
prisma/migrations/*/migration.sql   # Prisma (TypeScript)
*/migrations/__pycache__/           # Django (Python)

# Testing (framework-agnostic)
coverage/              # Generic
.nyc_output/           # JavaScript
.coverage              # Python
htmlcov/               # Python
*.cover                # Python
.pytest_cache/         # Python
test-results/          # Playwright

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# OS
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
.temp/
tmp/

# Swift Package Manager build
.build/
.swiftpm/

# Xcode user data
*.xcuserstate
*.xcuserdatad
xcuserdata/
project.xcworkspace/xcuserdata/
DerivedData/

# Xcode backup files
*.pbxproj.backup*
*.pbxproj.bak

# Audio files (stored in Cloudflare R2 bucket: anticrybaby)
# All audio content is hosted on R2 for streaming
# Upload script: cd babyincar-api && ./scripts/batch-upload-category.sh <category>
# R2 path format: audio/<category>/<filename>
BabyInCarApp/BabyInCarApp/Resources/Audio/**/*.wav
BabyInCarApp/BabyInCarApp/Resources/Audio/**/*.mp3
BabyInCarApp/BabyInCarApp/Resources/Audio/**/*.m4a
BabyInCarApp/BabyInCarApp/Resources/Audio/podcasts/
BabyInCarApp/BabyInCarApp/Resources/Audio/fairytales/

# R2 upload tracking
babyincar-api/r2-uploaded-files.json

# Cloudflare Wrangler cache
.wrangler/
.mf/
node_modules/.cache/

# Xcode build directory
BabyInCarApp/build/

# Downloaded audio for R2 upload
babyincar-api/audio-library/downloads/

# Maestro screenshots/artifacts
screenshots/
controls_*.png

# App-specific build artifacts
**/build/
BabyInCarApp.xcarchive/
*.ipa
*.app
*.dSYM

# Certificate files (sensitive)
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.pem
distribution.key
distribution.pem
ExportOptions.plist

# Generated icons (can be regenerated)
icon_*.png
# But keep app icons in Assets.xcassets
!**/Assets.xcassets/**/icon_*.png

# Markdown reports in root (should be in increment folders)
/*_COMPLETE.md
/*_REPORT.md
/*_GUIDE.md
/*_SUMMARY.md
/*_FIX*.md
/*_INSTRUCTIONS.md
/*_STATUS.md
/*_DEBUG.md
/*_VERIFICATION.md
/*.md
!README.md
!CLAUDE.md
!AGENTS.md
