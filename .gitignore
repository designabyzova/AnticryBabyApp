# SpecWeave
.specweave/cache/
.specweave/increments/*/logs/       # Gitignored, but structure preserved
.specweave/increments/*/test-results/
.specweave/state/jobs/              # Contains tokens/secrets
.specweave/docs-site-internal/      # Generated Docusaurus site for internal docs
.claude-plugin/                     # Plugin marketplace (framework files)
plugins/                            # Plugin implementations (framework files)

# Dependencies (framework-agnostic)
node_modules/          # JavaScript/TypeScript
.pnpm-store/
.yarn/
.npm/
__pycache__/           # Python
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
target/                # Rust
Cargo.lock
vendor/                # Go
go.sum

# Build outputs (framework-agnostic)
.next/                 # NextJS
dist/                  # Generic
build/                 # Generic
out/                   # Generic
.output/               # Nuxt
*.egg-info/            # Python
__pypackages__/        # Python
*.class                # Java
*.jar                  # Java
bin/                   # Go, Java

# Environment
.env
.env.local
.env.*.local
*.env

# Database (framework-agnostic)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
prisma/migrations/*/migration.sql   # Prisma (TypeScript)
*/migrations/__pycache__/           # Django (Python)

# Testing (framework-agnostic)
coverage/              # Generic
.nyc_output/           # JavaScript
.coverage              # Python
htmlcov/               # Python
*.cover                # Python
.pytest_cache/         # Python
test-results/          # Playwright

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
.temp/
tmp/

# Swift Package Manager build
.build/
.swiftpm/

# Large audio files (stored in Cloudflare R2)
# These files exceed GitHub's 100MB limit
# Upload to R2 with: cd babyincar-api && ./scripts/upload-audio-wrangler.sh
BabyInCarApp/BabyInCarApp/Resources/Audio/podcasts/
BabyInCarApp/BabyInCarApp/Resources/Audio/fairytales/

# Large nature sounds (stored in R2)
BabyInCarApp/BabyInCarApp/Resources/Audio/nature/ia_*.mp3

# Large classical files
BabyInCarApp/BabyInCarApp/Resources/Audio/classical/romantic_violin.mp3

# R2 upload tracking
babyincar-api/r2-uploaded-files.json
