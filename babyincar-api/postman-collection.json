    {
      "name": "Analytics & Learning History",
      "description": "Track effectiveness, emergency sessions, and learning data.\n\n**To clear ALL learning history for a baby:**\n1. First get your baby_id from GET /babies\n2. Run DELETE /analytics/history/:baby_id\n\nThis will reset:\n- Track effectiveness records\n- Emergency session history\n- Playback events\n- Effective tracks preferences",
      "item": [
        {
          "name": "Get Learning History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/history/{{babyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "history", "{{babyId}}"]
            },
            "description": "Get all learning history for a baby including:\n- Track effectiveness records\n- Emergency sessions\n- Effective tracks list"
          }
        },
        {
          "name": "CLEAR Learning History (Reset What Worked)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/history/{{babyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "history", "{{babyId}}"]
            },
            "description": "**USE THIS TO RESET LEARNING DATA**\n\nClears ALL learning history for a baby:\n- Track effectiveness records\n- Playback events\n- Emergency sessions\n- Resets effective_tracks in preferences\n\nAfter running this, the app will start fresh with no learned preferences."
          }
        },
        {
          "name": "Get Baby Insights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/insights/{{babyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "insights", "{{babyId}}"]
            }
          }
        },
        {
          "name": "Record Playback Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"track_id\": \"{{trackId}}\",\n  \"baby_id\": \"{{babyId}}\",\n  \"event_type\": \"play\",\n  \"session_id\": \"session_123\",\n  \"position_seconds\": 0,\n  \"context\": \"home\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/playback",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "playback"]
            }
          }
        },
        {
          "name": "Record Track Effectiveness",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baby_id\": \"{{babyId}}\",\n  \"track_id\": \"{{trackId}}\",\n  \"was_effective\": true,\n  \"calming_time_seconds\": 120,\n  \"context\": \"crying\",\n  \"emergency_mode\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/effectiveness",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "effectiveness"]
            }
          }
        },
        {
          "name": "Record Emergency Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baby_id\": \"{{babyId}}\",\n  \"started_at\": \"2024-01-15T10:00:00Z\",\n  \"ended_at\": \"2024-01-15T10:05:00Z\",\n  \"phases_completed\": [\"attention\", \"soothing\", \"calming\"],\n  \"was_successful\": true,\n  \"tracks_used\": [\"{{trackId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/emergency",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "emergency"]
            }
          }
        },
        {
          "name": "Update Emergency Session",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ended_at\": \"2024-01-15T10:10:00Z\",\n  \"was_successful\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/emergency/{{emergencySessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "emergency", "{{emergencySessionId}}"]
            }
          }
        }
      ]
