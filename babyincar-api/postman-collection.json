              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.babies && jsonData.babies.length > 0) {",
                  "    pm.environment.set('babyId', jsonData.babies[0].id);",
                  "}"
