{
  "info": {
    "_postman_id": "babyincar-api-collection",
    "name": "Baby in Car API",
    "description": "Complete API collection for the AnticryBaby/Baby in Car application.\n\n## Features\n- Audio content library with streaming\n- AI-powered personalized recommendations (Llama 3.1)\n- Baby profile management with developmental stage tracking\n- Analytics and effectiveness tracking\n- Premium subscriptions via App Store\n- CarPlay support\n\n## Authentication\nMost endpoints require JWT authentication. After login, the token is automatically set in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token if expired",
          "const tokenExpiry = pm.collectionVariables.get('token_expiry');",
          "const refreshToken = pm.collectionVariables.get('refresh_token');",
          "",
          "if (tokenExpiry && refreshToken && Date.now() > parseInt(tokenExpiry)) {",
          "    pm.sendRequest({",
          "        url: pm.collectionVariables.get('base_url') + '/auth/refresh',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({ refresh_token: refreshToken })",
          "        }",
          "    }, function (err, response) {",
          "        if (!err && response.code === 200) {",
          "            const data = response.json();",
          "            pm.collectionVariables.set('access_token', data.token);",
          "            pm.collectionVariables.set('refresh_token', data.refresh_token);",
          "            pm.collectionVariables.set('token_expiry', Date.now() + 3500000);",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "{{BASE_URL}}"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "token_expiry",
