  desc "Set pricing to FREE"
  lane :set_pricing do
    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    app = Spaceship::ConnectAPI::App.find("com.babyincar.app")
    UI.message("Found app: #{app.name}")

    # Get all territories
    territories = Spaceship::ConnectAPI::Territory.all
    UI.message("Found #{territories.count} territories")

    # Get available price points
    # Tier 0 = FREE
    begin
      # Create price schedule with tier 0 (FREE)
      usa = territories.find { |t| t.id == 'USA' }

      # Get app price points for USA
      response = Spaceship::ConnectAPI.get(
        "apps/#{app.id}/appPriceSchedule",
        { include: "baseTerritory,manualPrices" }
      )
      UI.message("Current schedule: #{response.body}")

      # Try to get price points
      price_points_response = Spaceship::ConnectAPI.get(
        "appPricePoints",
        {
          filter: { territory: "USA" },
          limit: 50
        }
      )

      if price_points_response.body && price_points_response.body["data"]
        points = price_points_response.body["data"]
        UI.message("Found #{points.count} price points")

        # Find FREE price point (customerPrice = 0)
        free_point = points.find { |p|
          p["attributes"]["customerPrice"] == "0" ||
          p["attributes"]["customerPrice"].to_f == 0
        }

        if free_point
          UI.success("Found FREE price point: #{free_point['id']}")
        end
      end
    rescue => e
      UI.error("Error: #{e.message}")
      UI.important("Note: Pricing must be set via App Store Connect UI for new apps")
      UI.important("URL: https://appstoreconnect.apple.com/apps/6756977992/distribution/pricing")
    end
  end

  desc "Set app privacy - no data collected"
  lane :set_privacy do
    require 'net/http'
    require 'json'
    require 'jwt'
    require 'openssl'

    # Read the private key
    key_path = File.expand_path("./keys/AuthKey_JZ2ML9M66A.p8", __dir__)
    private_key = OpenSSL::PKey::EC.new(File.read(key_path))

    # Create JWT token
    header = {
      alg: "ES256",
      kid: "JZ2ML9M66A",
      typ: "JWT"
    }

    now = Time.now.to_i
    payload = {
      iss: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      iat: now,
      exp: now + 1200,  # 20 minutes
      aud: "appstoreconnect-v1"
    }

    token = JWT.encode(payload, private_key, "ES256", header)
    UI.message("Generated JWT token")

    app_id = "6756977992"
    base_url = "https://api.appstoreconnect.apple.com/v1"

    # Helper to make API requests
    def make_request(method, url, token, body = nil)
      uri = URI(url)
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true

      case method
      when :get
        request = Net::HTTP::Get.new(uri)
      when :post
        request = Net::HTTP::Post.new(uri)
        request.body = body.to_json if body
      when :patch
        request = Net::HTTP::Patch.new(uri)
        request.body = body.to_json if body
      end

      request["Authorization"] = "Bearer #{token}"
      request["Content-Type"] = "application/json"

      http.request(request)
    end

    begin
      # Check current app data usages
      UI.message("Checking current privacy declarations...")
      response = make_request(:get, "#{base_url}/apps/#{app_id}/appDataUsages", token)
      UI.message("Data usages response: #{response.code}")

      if response.code == "200"
        data = JSON.parse(response.body)
        usages = data["data"] || []
        UI.message("Current data usages count: #{usages.count}")

        if usages.empty?
          UI.message("No data usages defined - good for 'no data collected'")
        end
      end

      # Now publish the privacy declarations
      # This endpoint creates/updates the publish state
      UI.message("Publishing privacy declarations...")

      publish_body = {
        data: {
          type: "appDataUsagePublishStates",
          attributes: {},
          relationships: {
            app: {
              data: {
                type: "apps",
                id: app_id
              }
            }
          }
        }
      }

      response = make_request(:post, "#{base_url}/appDataUsagePublishStates", token, publish_body)
      UI.message("Publish response: #{response.code} - #{response.body}")

      if response.code.to_i >= 200 && response.code.to_i < 300
        UI.success("✅ App Privacy published successfully!")
      elsif response.code == "409"
        UI.success("✅ App Privacy already published")
      else
        error_data = JSON.parse(response.body) rescue {}
        UI.error("Privacy publish failed: #{error_data}")
        UI.important("Please set App Privacy in App Store Connect UI:")
        UI.important("URL: https://appstoreconnect.apple.com/apps/#{app_id}/privacy")
      end

    rescue => e
      UI.error("Error: #{e.message}")
      UI.error(e.backtrace.first(5).join("\n"))
      UI.important("App Privacy requires configuration in App Store Connect UI")
      UI.important("URL: https://appstoreconnect.apple.com/apps/6756977992/privacy")
    end
  end

  desc "Register all App IDs with proper capabilities"
  lane :register_app_ids do
    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    # App IDs we need to register/update
    app_ids = {
      "com.babyincar.app" => {
        name: "Soothbee - Calm Baby",
        platform: "IOS",
        capabilities: ["SIRI", "APP_GROUPS"]
      },
      "com.babyincar.app.watchkitapp" => {
        name: "Soothbee Watch App",
        platform: "IOS",  # watchOS bundles register as iOS in Apple's system
        capabilities: ["APP_GROUPS"]
      },
      "com.babyincar.app.BabyInCarAppIntents" => {
        name: "Soothbee Intents Extension",
        platform: "IOS",
        capabilities: ["SIRI", "APP_GROUPS"]
      },
      "com.babyincar.app.BabyInCarAppIntentsUI" => {
        name: "Soothbee IntentsUI Extension",
        platform: "IOS",
        capabilities: ["APP_GROUPS"]
      }
    }

    # Get all existing bundle IDs
    existing_bundle_ids = Spaceship::ConnectAPI::BundleId.all
    UI.message("Found #{existing_bundle_ids.count} existing bundle IDs")

    app_ids.each do |identifier, config|
      UI.message("\n--- Processing: #{identifier} ---")

      existing = existing_bundle_ids.find { |b| b.identifier == identifier }

      if existing
        UI.success("Bundle ID exists: #{existing.name}")

        # Get current capabilities
        current_caps = existing.get_capabilities
        UI.message("Current capabilities: #{current_caps.map(&:capability_type).join(', ')}")

        # Enable missing capabilities
        config[:capabilities].each do |cap|
          cap_exists = current_caps.any? { |c| c.capability_type.to_s.upcase.include?(cap) }
          unless cap_exists
            UI.message("Enabling capability: #{cap}")
            begin
              existing.create_capability(cap)
              UI.success("✅ Enabled #{cap}")
            rescue => e
              UI.error("Failed to enable #{cap}: #{e.message}")
            end
          else
            UI.message("✅ #{cap} already enabled")
          end
        end
      else
        UI.message("Creating new Bundle ID: #{identifier}")
        begin
          new_bundle_id = Spaceship::ConnectAPI::BundleId.create(
            identifier: identifier,
            name: config[:name],
            platform: config[:platform]
          )
          UI.success("✅ Created Bundle ID: #{identifier}")

          # Enable capabilities
          config[:capabilities].each do |cap|
            begin
              new_bundle_id.create_capability(cap)
              UI.success("✅ Enabled #{cap}")
            rescue => e
              UI.error("Failed to enable #{cap}: #{e.message}")
            end
          end
        rescue => e
          UI.error("Failed to create Bundle ID: #{e.message}")
        end
      end
    end

    UI.success("\n✅ App ID registration complete!")
    UI.important("Now regenerate profiles: fastlane ios regenerate_profiles")
  end

  desc "Configure Xcode Cloud workflow for TestFlight"
  lane :configure_xcode_cloud do
    require 'net/http'
    require 'json'
    require 'jwt'
    require 'openssl'

    # Read the private key
    key_path = File.expand_path("./keys/AuthKey_JZ2ML9M66A.p8", __dir__)
    private_key = OpenSSL::PKey::EC.new(File.read(key_path))

    # Create JWT token
    header = {
      alg: "ES256",
      kid: "JZ2ML9M66A",
      typ: "JWT"
    }

    now = Time.now.to_i
    payload = {
      iss: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      iat: now,
      exp: now + 1200,
      aud: "appstoreconnect-v1"
    }

    token = JWT.encode(payload, private_key, "ES256", header)
    UI.message("Generated JWT token")

    app_id = "6756977992"
    base_url = "https://api.appstoreconnect.apple.com/v1"

    # Helper to make API requests
    def make_request(method, url, token, body = nil)
      uri = URI(url)
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true

      case method
      when :get
        request = Net::HTTP::Get.new(uri)
      when :post
        request = Net::HTTP::Post.new(uri)
        request.body = body.to_json if body
      when :patch
        request = Net::HTTP::Patch.new(uri)
        request.body = body.to_json if body
      end

      request["Authorization"] = "Bearer #{token}"
      request["Content-Type"] = "application/json"

      http.request(request)
    end

    begin
      # Step 1: Get the CI product (Xcode Cloud project)
      UI.message("Fetching Xcode Cloud products...")
      response = make_request(:get, "#{base_url}/ciProducts?filter[app]=#{app_id}", token)

      if response.code != "200"
        UI.error("Failed to get CI products: #{response.body}")
        raise "API Error"
      end

      products = JSON.parse(response.body)["data"]
      if products.empty?
        UI.error("No Xcode Cloud product found for this app")
        raise "No CI product"
      end

      product_id = products.first["id"]
      UI.success("Found CI product: #{product_id}")

      # Step 2: Get existing workflows
      UI.message("Fetching workflows...")
      response = make_request(:get, "#{base_url}/ciProducts/#{product_id}/workflows", token)

      if response.code != "200"
        UI.error("Failed to get workflows: #{response.body}")
        raise "API Error"
      end

      workflows = JSON.parse(response.body)["data"]
      UI.message("Found #{workflows.count} workflows")

      workflows.each do |workflow|
        workflow_id = workflow["id"]
        workflow_name = workflow["attributes"]["name"]
        UI.message("Processing workflow: #{workflow_name} (#{workflow_id})")

        # Step 3: Get full workflow details with included relationships
        response = make_request(:get, "#{base_url}/ciWorkflows/#{workflow_id}", token)
        workflow_response = JSON.parse(response.body)
        workflow_data = workflow_response["data"]
        next unless workflow_data
        UI.message("Workflow details: #{workflow_data['attributes'].keys.join(', ')}")

        # Check current attributes
        attrs = workflow_data["attributes"]
        UI.message("Current isEnabled: #{attrs['isEnabled']}")
        UI.message("Current actions: #{attrs['actions']}")

        # Get product for beta groups
        product_response = make_request(:get, "#{base_url}/ciProducts/#{product_id}?include=app", token)
        product_data = JSON.parse(product_response.body)

        app_relationship = product_data["data"]["relationships"]["app"]["data"]
        actual_app_id = app_relationship ? app_relationship["id"] : app_id
        UI.message("App ID for beta groups: #{actual_app_id}")

        # Step 4: Get or create internal beta group
        UI.message("Fetching beta groups...")
        beta_response = make_request(:get, "#{base_url}/apps/#{actual_app_id}/betaGroups?filter[isInternalGroup]=true", token)

        if beta_response.code == "200"
          beta_groups = JSON.parse(beta_response.body)["data"]
          UI.message("Found #{beta_groups.count} internal beta groups")

          if beta_groups.any?
            internal_group = beta_groups.first
            UI.success("Using internal beta group: #{internal_group['attributes']['name']} (#{internal_group['id']})")
          else
            UI.important("No internal beta groups found - builds will need manual assignment")
          end
        else
          UI.error("Could not fetch beta groups: #{beta_response.code}")
        end

        # Step 5: Check for existing artifacts that could be distributed
        UI.message("\nChecking for build artifacts...")
        builds_response = make_request(:get, "#{base_url}/ciWorkflows/#{workflow_id}/buildRuns?limit=5&sort=-number", token)

        if builds_response.code == "200"
          build_runs = JSON.parse(builds_response.body)["data"]
          UI.message("Recent builds: #{build_runs.count}")

          build_runs.each do |run|
            run_id = run["id"]
            run_status = run["attributes"]["completionStatus"]
            run_number = run["attributes"]["number"]
            UI.message("  Build ##{run_number}: #{run_status || 'in progress'}")

            # Check for issues/errors
            if run_status == "FAILED"
              issues_response = make_request(:get, "#{base_url}/ciBuildRuns/#{run_id}/actions", token)
              if issues_response.code == "200"
                actions_data = JSON.parse(issues_response.body)["data"]
                actions_data.each do |act|
                  act_name = act["attributes"]["name"]
                  act_status = act["attributes"]["completionStatus"]
                  UI.message("    Action: #{act_name} - #{act_status}")

                  if act_status == "FAILED"
                    # Get issues for this action
                    action_id = act["id"]
                    action_issues_response = make_request(:get, "#{base_url}/ciBuildActions/#{action_id}/issues", token)
                    if action_issues_response.code == "200"
                      issues = JSON.parse(action_issues_response.body)["data"]
                      issues.each do |issue|
                        UI.error("      Issue: #{issue['attributes']['message']}")
                        UI.message("      Category: #{issue['attributes']['category']}")
                        UI.message("      File: #{issue['attributes']['fileSource']}")
                      end
                    end
                  end
                end
              end
            end

            # Check for artifacts
            if run_status == "SUCCEEDED"
              artifacts_response = make_request(:get, "#{base_url}/ciBuildRuns/#{run_id}/artifacts", token)
              if artifacts_response.code == "200"
                artifacts = JSON.parse(artifacts_response.body)["data"]
                UI.message("    Artifacts: #{artifacts.count}")
                artifacts.each do |art|
                  UI.message("      - #{art['attributes']['fileName']} (#{art['attributes']['fileType']})")
                end
              end
            end
          end
        end

        # Step 6: Try to update workflow with TestFlight distribution
        # The actions array can include buildDistributionAudience
        current_actions = attrs["actions"] || []

        # Check if any action already has TestFlight configured
        has_testflight = current_actions.any? { |a| a["buildDistributionAudience"] }

        if has_testflight
          UI.success("✅ TestFlight distribution already configured!")
        else
          UI.message("\nAttempting to configure TestFlight distribution...")

          # Update actions to add TestFlight distribution to iOS archive
          # buildDistributionAudience must be a STRING: 'INTERNAL_ONLY' or 'APP_STORE_ELIGIBLE'
          updated_actions = current_actions.map do |action|
            if action["actionType"] == "ARCHIVE" && action["platform"] == "IOS"
              action.merge("buildDistributionAudience" => "INTERNAL_ONLY")
            else
              action
            end
          end

          update_body = {
            data: {
              type: "ciWorkflows",
              id: workflow_id,
              attributes: {
                actions: updated_actions
              }
            }
          }

          response = make_request(:patch, "#{base_url}/ciWorkflows/#{workflow_id}", token, update_body)

          if response.code.to_i >= 200 && response.code.to_i < 300
            UI.success("✅ TestFlight distribution configured!")
          else
            error_body = JSON.parse(response.body) rescue response.body
            UI.error("Could not configure via API: #{response.code}")
            UI.message("API response: #{error_body}")

            UI.important("\n=== Manual TestFlight Configuration Required ===")
            UI.important("To enable automatic TestFlight deployment:")
            UI.important("1. Go to: https://appstoreconnect.apple.com/apps/#{actual_app_id}/integrations/cloudbuilds")
            UI.important("2. Click on workflow: #{workflow_name}")
            UI.important("3. Click 'Edit Workflow'")
            UI.important("4. Under 'Post-Actions', click '+'")
            UI.important("5. Select 'TestFlight Internal Testing'")
            UI.important("6. Choose the archive artifact and beta group")
            UI.important("7. Save the workflow")
          end
        end
      end

      UI.success("\n✅ Xcode Cloud workflow configuration complete!")
      UI.important("New builds will automatically deploy to TestFlight")

    rescue => e
      UI.error("Error: #{e.message}")
      UI.error(e.backtrace.first(5).join("\n"))
      UI.important("\nManual configuration required:")
      UI.important("1. Go to: https://appstoreconnect.apple.com/apps/6756977992/integrations/cloudbuilds")
      UI.important("2. Edit your workflow")
      UI.important("3. In 'Post-Actions' section, add 'TestFlight Internal Testing'")
      UI.important("4. Save the workflow")
    end
  end

  desc "Upload IPA to TestFlight"
  lane :upload_testflight do |options|
    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    ipa_path = options[:ipa] || Dir.glob("#{Dir.home}/Downloads/*.ipa").max_by { |f| File.mtime(f) }

    unless ipa_path && File.exist?(ipa_path)
      UI.error("No IPA file found. Provide path via 'ipa:path/to/file.ipa' or place IPA in Downloads folder")
      next
    end

    UI.message("Uploading IPA: #{ipa_path}")

    pilot(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ Build uploaded to TestFlight!")
  end

  desc "Build and upload to TestFlight locally"
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    # Increment build number
    increment_build_number(
      xcodeproj: "./BabyInCarApp.xcodeproj"
    )

    # Build the archive
    build_app(
      scheme: "BabyInCarApp",
      export_method: "app-store",
      output_directory: "./build",
      export_options: {
        signingStyle: "automatic",
        uploadSymbols: true,
        teamID: "NMCB2JZ7QG"
      }
    )

    # Upload to TestFlight
    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("✅ Build uploaded to TestFlight!")
  end

  desc "Archive Release + upload to TestFlight (uses version/build already set in project)"
  lane :release do
    # xcpretty crashes on non-ASCII in build output unless locale is UTF-8.
    ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty? || !ENV["LANG"].include?("UTF-8")
    ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty? || !ENV["LC_ALL"].include?("UTF-8")

    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    # NOTE: No increment_build_number — version/build already committed in source.
    build_app(
      scheme: "BabyInCarApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "BabyInCarApp.ipa",
      clean: true,
      export_options: {
        signingStyle: "automatic",
        uploadSymbols: true,
        teamID: "NMCB2JZ7QG"
      }
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ 1.3.0 (build 14) uploaded to TestFlight!")
  end

  desc "Check app submission readiness"
  lane :check_ready do
    api_key = app_store_connect_api_key(
      key_id: "JZ2ML9M66A",
      issuer_id: "a9be87c1-47d8-40f2-897d-75df80a540fb",
      key_filepath: "./fastlane/keys/AuthKey_JZ2ML9M66A.p8"
    )

    app = Spaceship::ConnectAPI::App.find("com.babyincar.app")
    UI.message("=" * 60)
    UI.message("APP SUBMISSION READINESS CHECK")
    UI.message("=" * 60)
    UI.message("App: #{app.name}")
    UI.message("Bundle ID: #{app.bundle_id}")

    # Check version
    versions = app.get_app_store_versions
    prep_version = versions.find { |v| v.app_store_state == 'PREPARE_FOR_SUBMISSION' }

    if prep_version
      UI.success("Version: #{prep_version.version_string}")
      UI.success("State: #{prep_version.app_store_state}")

      # Check localizations
      localizations = prep_version.get_app_store_version_localizations
      loc = localizations.first
      if loc
        UI.message("Locale: #{loc.locale}")
        UI.message("Description: #{loc.description ? 'SET' : 'MISSING'}")
        UI.message("Keywords: #{loc.keywords ? 'SET' : 'MISSING'}")
      end
    else
      UI.error("No version in PREPARE_FOR_SUBMISSION state")
    end

    # Check app info
    app_infos = app.fetch_app_infos
    app_info = app_infos.first
    UI.message("App Info State: #{app_info.state}")

    # Age rating
    age_rating = app_info.fetch_age_rating_declaration
    UI.message("Age Rating: #{age_rating ? 'SET' : 'MISSING'}")

    UI.message("=" * 60)
    UI.important("MANUAL CHECKS REQUIRED:")
    UI.important("1. Pricing - Set to FREE in App Store Connect")
    UI.important("2. App Privacy - Declare 'No data collected'")
    UI.important("3. Binary - Upload via Xcode or Transporter")
    UI.message("=" * 60)
  end
end
