<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Information -->
    <key>CFBundleName</key>
    <string>Soothbee</string>
    <key>CFBundleDisplayName</key>
    <string>Soothbee</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>14</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!-- iOS Configuration -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>

    <!-- Supported Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Scene Configuration (with CarPlay support) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>CarPlay Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
        <string>processing</string>
    </array>

    <!-- Background Task Identifiers (required for 'processing' mode) -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.babyincar.app.refresh</string>
        <string>com.babyincar.app.audioprocessing</string>
    </array>

    <!-- Privacy Usage Descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Soothbee uses the microphone to detect your baby's cry type and automatically play personalized soothing music.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Soothbee uses speech recognition for hands-free voice commands while driving, so you can control playback without touching your phone.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Soothbee can access your photos to set a profile picture for your baby.</string>
    <key>NSCameraUsageDescription</key>
    <string>Soothbee can use your camera to take a profile picture for your baby.</string>

    <!-- App Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsArbitraryLoadsForMedia</key>
        <true/>
    </dict>

    <!-- Status Bar -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- Now Playing Info -->
    <key>MPNowPlayingInfoPropertyIsLiveStream</key>
    <false/>

    <!-- Siri Integration -->
    <key>NSSiriUsageDescription</key>
    <string>Soothbee uses Siri so you can control playback hands-free by saying things like "Hey Siri, play lullabies in Soothbee".</string>

    <!-- Siri Intents Supported -->
    <!-- NOTE: Pause/Resume/Skip are handled via MPRemoteCommandCenter (Now Playing controls) -->
    <key>INIntentsSupported</key>
    <array>
        <string>INPlayMediaIntent</string>
        <string>INSearchForMediaIntent</string>
        <string>INAddMediaIntent</string>
    </array>

    <!-- Alternative App Names for Siri Recognition -->
    <key>INAlternativeAppNames</key>
    <array>
        <dict>
            <key>INAlternativeAppName</key>
            <string>Soothbee</string>
        </dict>
        <dict>
            <key>INAlternativeAppName</key>
            <string>Soothbee Music</string>
        </dict>
        <dict>
            <key>INAlternativeAppName</key>
            <string>Baby Soother</string>
        </dict>
    </array>
</dict>
</plist>
