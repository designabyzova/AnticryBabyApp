    "about.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت مهدئ بالذكاء الاصطناعي لرحلات هادئة مع طفلك. محتوى مخصص حسب العمر وتحكم صوتي وميزة إيقاف البكاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-gestützte beruhigende Klänge für ruhige Autofahrten mit Ihrem Baby. Personalisierte Inhalte, Sprachsteuerung und Weinstopp-Funktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-powered calming audio for peaceful car rides with your little one. Using age-personalized content, voice control, and our emergency cry-stop feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio relajante con IA para viajes tranquilos con tu bebé. Contenido personalizado por edad, control por voz y función de parada de llanto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio apaisant par IA pour des trajets paisibles avec votre bébé. Contenu personnalisé, contrôle vocal et fonction d'arrêt des pleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio rilassante con IA per viaggi tranquilli con il tuo bambino. Contenuti personalizzati per età, controllo vocale e funzione anti-pianto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIによる癒しのオーディオで、お子様との穏やかなドライブを。年齢に合わせたコンテンツ、音声操作、緊急泣き止み機能を搭載。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio relaxante com IA para viagens tranquilas com seu bebê. Conteúdo personalizado por idade, controle por voz e função de parar o choro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успокаивающее аудио на базе ИИ для спокойных поездок с малышом. Персонализированный контент, голосовое управление и экстренная остановка плача."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI驱动的舒缓音频，让您和宝宝的出行更加平静。提供个性化内容、语音控制和紧急止哭功能。"
          }
        }
      }
    },
