//
//  EffectivenessComponents.swift
//  BabyInCarApp
//
//  UI components for the "It Helped!" feedback system
//  Includes floating button, badges, toasts, and detail popovers
//

import SwiftUI
import UIKit

// MARK: - "It Helped!" Button

/// Floating feedback button for marking when a track successfully calms the baby
struct ItHelpedButton: View {
    let onTap: () -> Void

    @State private var isPressed = false
    @State private var showSuccess = false
    @State private var scale: CGFloat = 1.0

    var body: some View {
        Button {
            triggerSuccess()
            onTap()
        } label: {
            ZStack {
                // Outer glow
                Circle()
                    .fill(Color.appSuccess.opacity(0.3))
                    .frame(width: 68, height: 68)
                    .blur(radius: 10)
                    .scaleEffect(showSuccess ? 1.5 : 1.0)
                    .opacity(showSuccess ? 0 : 0.5)

                // Main button circle
                Circle()
                    .fill(
                        LinearGradient(
                            colors: [Color.appSuccess, Color.appSuccess.opacity(0.8)],
                            startPoint: .topLeading,
                            endPoint: .bottomTrailing
                        )
                    )
                    .frame(width: 60, height: 60)
                    .shadow(color: Color.appSuccess.opacity(0.4), radius: 8, y: 4)

                // Shine effect
                Circle()
                    .fill(
                        LinearGradient(
                            colors: [Color.white.opacity(0.3), Color.clear],
                            startPoint: .top,
                            endPoint: .center
                        )
                    )
                    .frame(width: 60, height: 60)

                // Icon and text
                VStack(spacing: 2) {
                    Image(systemName: showSuccess ? "checkmark" : "hand.thumbsup.fill")
                        .font(.system(size: 22, weight: .semibold))
                        .foregroundColor(.white)
                        .rotationEffect(.degrees(showSuccess ? 0 : -10))
                }
            }
            .scaleEffect(scale)
        }
        .buttonStyle(PlainButtonStyle())
        .simultaneousGesture(
            DragGesture(minimumDistance: 0)
                .onChanged { _ in
                    withAnimation(.spring(response: 0.2, dampingFraction: 0.6)) {
                        scale = 0.9
                    }
                }
                .onEnded { _ in
                    withAnimation(.spring(response: 0.2, dampingFraction: 0.6)) {
                        scale = 1.0
                    }
                }
        )
        .accessibilityLabel("It Helped!")
        .accessibilityHint("Mark this track as helpful for calming your baby")
    }

    private func triggerSuccess() {
        // Haptic feedback
        UINotificationFeedbackGenerator().notificationOccurred(.success)

        // Animate success state
        withAnimation(.spring(response: 0.3, dampingFraction: 0.6)) {
            showSuccess = true
            scale = 1.2
        }

        // Reset after animation
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
            withAnimation(.spring(response: 0.3)) {
                showSuccess = false
                scale = 1.0
            }
        }
    }
}

// MARK: - Success Toast

/// Toast notification confirming feedback was recorded
struct SuccessToast: View {
    let message: String
    @Binding var isShowing: Bool

    var body: some View {
        VStack {
            if isShowing {
                HStack(spacing: 12) {
                    Image(systemName: "checkmark.circle.fill")
                        .font(.system(size: 20))
                        .foregroundColor(.appSuccess)

                    Text(message)
                        .font(.appBody)
                        .foregroundColor(.appText)
                }
                .padding(.horizontal, 20)
                .padding(.vertical, 14)
                .background(
                    Capsule()
                        .fill(Color.appCardBackground)
                        .shadow(color: .black.opacity(0.1), radius: 10, y: 4)
                )
                .transition(.move(edge: .top).combined(with: .opacity))
            }

            Spacer()
        }
        .padding(.top, 60)
        .onAppear {
            // Auto-dismiss after 2 seconds
            DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) {
                withAnimation(.spring(response: 0.3)) {
                    isShowing = false
                }
            }
        }
    }
}

// MARK: - Effectiveness Badge

/// Small badge showing effectiveness percentage on track cards
struct EffectivenessBadge: View {
    let score: Double
    var showPercentage: Bool = true
    var size: BadgeSize = .medium

    enum BadgeSize {
        case small, medium, large

        var fontSize: CGFloat {
            switch self {
            case .small: return 10
            case .medium: return 12
            case .large: return 14
            }
        }

        var padding: EdgeInsets {
            switch self {
            case .small: return EdgeInsets(top: 2, leading: 6, bottom: 2, trailing: 6)
            case .medium: return EdgeInsets(top: 4, leading: 8, bottom: 4, trailing: 8)
            case .large: return EdgeInsets(top: 6, leading: 10, bottom: 6, trailing: 10)
            }
        }

        var iconSize: CGFloat {
            switch self {
            case .small: return 8
            case .medium: return 10
            case .large: return 12
            }
        }
    }

    private var tier: EffectivenessTier {
        switch score {
        case 70...100: return .high
        case 40..<70: return .medium
        default: return .low
        }
    }

    private var badgeColor: Color {
        switch tier {
        case .high: return .appSuccess
        case .medium: return .appWarning
        case .low: return .appTextTertiary
        }
    }

    var body: some View {
        HStack(spacing: 4) {
            Image(systemName: tier == .high ? "star.fill" : "chart.bar.fill")
                .font(.system(size: size.iconSize, weight: .bold))

            if showPercentage {
                Text("\(Int(score))%")
                    .font(.system(size: size.fontSize, weight: .bold))
            }
        }
        .foregroundColor(.white)
        .padding(size.padding)
        .background(
            Capsule()
                .fill(badgeColor)
        )
        .shadow(color: badgeColor.opacity(0.3), radius: 4, y: 2)
    }
}

// MARK: - Effectiveness Detail Popover

/// Detailed effectiveness information shown on long press
struct EffectivenessDetailPopover: View {
    let effectiveness: TrackEffectiveness
    @Binding var isPresented: Bool

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            // Header
            HStack {
                VStack(alignment: .leading, spacing: 4) {
                    Text("Effectiveness")
                        .font(.appHeadline)
                        .foregroundColor(.appText)

                    Text("\(Int(effectiveness.effectivenessScore))% success rate")
                        .font(.appBody)
                        .foregroundColor(.appTextSecondary)
                }

                Spacer()

                // Close button
                Button {
                    withAnimation(.spring(response: 0.25)) {
                        isPresented = false
                    }
                } label: {
                    Image(systemName: "xmark.circle.fill")
                        .font(.title2)
                        .foregroundColor(.appTextTertiary)
                }
            }

            Divider()

            // Stats grid
            VStack(spacing: 12) {
                StatRow(
                    icon: "hand.thumbsup.fill",
                    label: "Times helped",
                    value: "\(effectiveness.helpedCount)",
                    color: .appSuccess
                )

                StatRow(
                    icon: "play.fill",
                    label: "Total plays",
                    value: "\(effectiveness.totalPlays)",
                    color: .appPrimary
                )

                if let lastHelped = effectiveness.lastHelped {
                    StatRow(
                        icon: "clock.fill",
                        label: "Last helped",
                        value: lastHelped.formatted(.relative(presentation: .named)),
                        color: .appSecondary
                    )
                }
            }

            // Cry type breakdown (if available)
            if !effectiveness.cryTypeBreakdown.isEmpty {
                Divider()

                Text("By cry type")
                    .font(.appCaption)
                    .foregroundColor(.appTextSecondary)

                ForEach(Array(effectiveness.cryTypeBreakdown.keys.sorted()), id: \.self) { cryType in
                    if let stats = effectiveness.cryTypeBreakdown[cryType], stats.helpedCount > 0 {
                        HStack {
                            Text(cryType)
                                .font(.appBody)
                                .foregroundColor(.appText)

                            Spacer()

                            Text("\(stats.helpedCount)/\(stats.totalCount)")
                                .font(.appCaptionMedium)
                                .foregroundColor(.appTextSecondary)

                            Text("(\(Int(stats.successRate))%)")
                                .font(.appCaptionMedium)
                                .foregroundColor(.appSuccess)
                        }
                    }
                }
            }
        }
        .padding(20)
        .background(
            RoundedRectangle(cornerRadius: DesignTokens.radiusL)
                .fill(Color.appCardBackground)
                .shadow(color: .black.opacity(0.15), radius: 20, y: 10)
        )
        .padding(.horizontal, 24)
    }
}

// MARK: - Stat Row Helper

private struct StatRow: View {
    let icon: String
    let label: String
    let value: String
    let color: Color

    var body: some View {
        HStack(spacing: 12) {
            Image(systemName: icon)
                .font(.system(size: 16))
                .foregroundColor(color)
                .frame(width: 24)

            Text(label)
                .font(.appBody)
                .foregroundColor(.appTextSecondary)

            Spacer()

            Text(value)
                .font(.appBodyMedium)
                .foregroundColor(.appText)
        }
    }
}

// MARK: - Cry Type Tag

/// Small tag showing a cry type this track is effective for
struct CryTypeTag: View {
    let cryType: CryType

    var body: some View {
        HStack(spacing: 4) {
            Image(systemName: cryType.icon)
                .font(.system(size: 10))

            Text(cryType.rawValue)
                .font(.system(size: 10, weight: .medium))
        }
        .foregroundColor(.appTextSecondary)
        .padding(.horizontal, 8)
        .padding(.vertical, 4)
        .background(
            Capsule()
                .fill(Color.appBackground)
        )
        .overlay(
            Capsule()
                .stroke(Color.appTextTertiary.opacity(0.3), lineWidth: 1)
        )
    }
}

// MARK: - Compact "It Helped" Button

/// Smaller version of the feedback button for mini player or compact layouts
struct ItHelpedButtonCompact: View {
    let onTap: () -> Void

    @State private var showSuccess = false

    var body: some View {
        Button {
            UIImpactFeedbackGenerator(style: .medium).impactOccurred()
            withAnimation(.spring(response: 0.3)) {
                showSuccess = true
            }
            onTap()
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
                withAnimation(.spring(response: 0.3)) {
                    showSuccess = false
                }
            }
        } label: {
            Image(systemName: showSuccess ? "checkmark" : "hand.thumbsup")
                .font(.system(size: 16, weight: .semibold))
                .foregroundColor(showSuccess ? .appSuccess : .appText)
                .frame(width: 36, height: 36)
                .background(
                    Circle()
                        .fill(showSuccess ? Color.appSuccess.opacity(0.15) : Color.appCardBackground)
                )
                .overlay(
                    Circle()
                        .stroke(Color.appTextTertiary.opacity(0.2), lineWidth: 1)
                )
        }
        .buttonStyle(ScaleButtonStyle())
        .accessibilityLabel("It Helped!")
    }
}

// MARK: - Cry Type Picker Sheet

/// Sheet for manually selecting cry type when providing "It Helped!" feedback
struct CryTypePickerSheet: View {
    let onSelect: (CryType) -> Void
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        NavigationStack {
            VStack(spacing: DesignTokens.spacingL) {
                // Header
                VStack(spacing: DesignTokens.spacingS) {
                    Image(systemName: "hand.thumbsup.fill")
                        .font(.system(size: 40))
                        .foregroundColor(.appSuccess)

                    Text("What type of cry was it?")
                        .font(.appTitle3)
                        .foregroundColor(.appText)

                    Text("This helps us learn what works best for different situations")
                        .font(.appBody)
                        .foregroundColor(.appTextSecondary)
                        .multilineTextAlignment(.center)
                }
                .padding(.top, DesignTokens.spacingL)

                // Cry type options
                VStack(spacing: DesignTokens.spacingM) {
                    ForEach(CryType.allCases, id: \.self) { cryType in
                        Button {
                            onSelect(cryType)
                            dismiss()
                        } label: {
                            HStack(spacing: DesignTokens.spacingM) {
                                Image(systemName: cryType.icon)
                                    .font(.system(size: 20))
                                    .foregroundColor(.appPrimary)
                                    .frame(width: 32)

                                VStack(alignment: .leading, spacing: 2) {
                                    Text(cryType.rawValue)
                                        .font(.appBodyMedium)
                                        .foregroundColor(.appText)

                                    Text(cryType.suggestedAction)
                                        .font(.appCaption)
                                        .foregroundColor(.appTextSecondary)
                                }

                                Spacer()

                                Image(systemName: "chevron.right")
                                    .font(.system(size: 14))
                                    .foregroundColor(.appTextTertiary)
                            }
                            .padding()
                            .background(
                                RoundedRectangle(cornerRadius: DesignTokens.radiusM)
                                    .fill(Color.appCardBackground)
                            )
                        }
                        .buttonStyle(ScaleButtonStyle())
                    }
                }
                .padding(.horizontal)

                Spacer()
            }
            .navigationTitle("Select Cry Type")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button("Cancel") {
                        dismiss()
                    }
                    .foregroundColor(.appPrimary)
                }
            }
        }
    }
}

