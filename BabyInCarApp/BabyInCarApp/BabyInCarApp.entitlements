<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Groups for shared data -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.babyincar</string>
    </array>

    <!-- Keychain sharing -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.babyincar</string>
    </array>

    <!-- Siri capability for voice control -->
    <key>com.apple.developer.siri</key>
    <true/>

    <!-- CarPlay Audio capability - DISABLED until Apple approval -->
    <!-- To enable: Apply at https://developer.apple.com/contact/carplay/ -->
    <!-- Then uncomment below and add to provisioning profile -->
    <!--
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    -->
</dict>
</plist>
