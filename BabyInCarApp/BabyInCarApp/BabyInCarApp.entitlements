<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CarPlay Audio App -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>

    <!-- In-App Purchases -->
    <key>com.apple.developer.in-app-payments</key>
    <array>
        <string>merchant.com.babyincar</string>
    </array>

    <!-- iCloud for data sync -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.babyincar</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
        <string>CloudKit</string>
    </array>

    <!-- App Groups for shared data -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.babyincar</string>
    </array>

    <!-- Keychain sharing -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.babyincar</string>
    </array>

    <!-- Audio Session -->
    <key>com.apple.developer.playable-content</key>
    <true/>
</dict>
</plist>
